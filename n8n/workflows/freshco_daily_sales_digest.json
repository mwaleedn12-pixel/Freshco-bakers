{
  "name": "Freshco Bakers - Daily Sales & Inventory Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 22 * * *"
            }
          ]
        }
      },
      "name": "Cron Daily (10:00 PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "id": "cron-daily-trigger"
    },
    {
      "parameters": {
        "requestMethod": "GET",
        "url": "http://backend:8000/api/v1/analytics/summary",
        "options": {}
      },
      "name": "Fetch Daily Summary from Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        460,
        300
      ],
      "id": "http-fetch-summary"
    },
    {
      "parameters": {
        "jsCode": "const summary = $input.first().json;\nconst today = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });\n\nconst totalRevenue = Number(summary.total_revenue || 0).toLocaleString();\nconst totalOrders = summary.orders_count || 0;\nconst avgOrder = summary.average_order_value || 0;\nconst topItems = (summary.top_selling_items || []).map(it => `• ${it.name}: ${it.sold_quantity} sold`).join('\\n') || '• Standard Bakery items';\n\nconst message = `📊 *FRESHCO BAKERS — DAILY CLOSING REPORT* 📊\\n` +\n  `📅 *Date:* ${today}\\n\\n` +\n  `💰 *Total Revenue:* Rs. ${totalRevenue}\\n` +\n  `📦 *Total Orders:* ${totalOrders}\\n` +\n  `📈 *Avg Order Value:* Rs. ${avgOrder}\\n\\n` +\n  `⭐ *Top Sellers:*\\n${topItems}\\n\\n` +\n  `✅ POS & Website databases synced successfully.`;\n\nreturn {\n  json: {\n    report_date: today,\n    formatted_report: message\n  }\n};\n"
      },
      "name": "Format Daily Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "id": "code-format-report"
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "=https://api.telegram.org/botYOUR_TELEGRAM_BOT_TOKEN/sendMessage",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"chat_id\": \"YOUR_TELEGRAM_OWNER_CHAT_ID\",\n  \"text\": \"{{ $json.formatted_report }}\",\n  \"parse_mode\": \"Markdown\"\n}"
      },
      "name": "Send Report to Owner Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        940,
        220
      ],
      "id": "http-send-report-telegram"
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "=https://api.ultramsg.com/INSTANCE_ID/messages/chat",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"token\": \"YOUR_ULTRAMSG_TOKEN\",\n  \"to\": \"923348984654\",\n  \"body\": \"{{ $json.formatted_report }}\"\n}"
      },
      "name": "Send Report to Owner WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        940,
        380
      ],
      "id": "http-send-report-whatsapp"
    }
  ],
  "connections": {
    "Cron Daily (10:00 PM)": {
      "main": [
        [
          {
            "node": "Fetch Daily Summary from Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Daily Summary from Backend": {
      "main": [
        [
          {
            "node": "Format Daily Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Daily Report": {
      "main": [
        [
          {
            "node": "Send Report to Owner Telegram",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Report to Owner WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
