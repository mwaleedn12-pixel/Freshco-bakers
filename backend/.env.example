ENVIRONMENT=development
DEBUG=true

SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://freshco_user:freshco_pass@localhost:5432/freshco_bakers_db

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Trusted hosts — restrict in production (e.g. ["freshcobakers.com","api.freshcobakers.com"])
ALLOWED_HOSTS=["*"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
RATE_LIMIT_ENABLED=true

# Redis (optional — used for shared rate-limit state across workers)
REDIS_URL=

# Logging
LOG_LEVEL=INFO
